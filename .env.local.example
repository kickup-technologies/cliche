# =============================================
# COPIA ESTE ARCHIVO A .env.local
# Y RELLENA TUS CREDENCIALES
# (En producción, define las mismas variables en Vercel → Settings → Environment)
# =============================================

# --- SUPABASE (ya configurado) ---
NEXT_PUBLIC_SUPABASE_URL=https://zyednfadgizlsnsfvjow.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inp5ZWRuZmFkZ2l6bHNuc2Z2am93Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk0MDIwNzUsImV4cCI6MjA5NDk3ODA3NX0.dF5F9B1GWTeYJhvJyNSnqbjfE1HCTxyIsoRrLScuEt0
# Consigue el service_role en: Supabase → Settings → API
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# --- WOMPI (pasarela de pago) ---
# Consíguelas en: Wompi → Desarrolladores → Llaves de producción
WOMPI_PUBLIC_KEY=pub_prod_...
WOMPI_INTEGRITY_SECRET=prod_integrity_...
# Secreto de eventos del webhook (Wompi → Eventos): URL del webhook =
#   https://clichecolombia.com/api/webhooks/wompi
WOMPI_EVENTS_SECRET=prod_events_...

# --- CORREO (SMTP — nodemailer, sin dependencias de terceros) ---
# Para Google Workspace usa una "Contraseña de aplicación" como SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                 # true solo si usas el puerto 465
SMTP_USER=monica@clichecolombia.com
SMTP_PASS=tu_app_password_aqui
SMTP_FROM=Cliché Aromas <monica@clichecolombia.com>
# Correo que recibe las alertas de nuevos pedidos Y es la ÚNICA cuenta con
# acceso al panel admin (2º factor: código OTP de 4 dígitos a este correo).
ADMIN_EMAIL=monica@clichecolombia.com

# --- ADMIN / SEGURIDAD ---
# (Opcional) Secreto dedicado para firmar la cookie del panel admin.
# Si se omite, se usa SUPABASE_SERVICE_ROLE_KEY como secreto de firma.
ADMIN_SESSION_SECRET=
# Secreto que protege los cron jobs de Vercel (lo genera Vercel automáticamente)
CRON_SECRET=

# --- APP ---
NEXT_PUBLIC_APP_URL=https://clichecolombia.com

# --- META CONVERSIONS API (opcional, para eventos de compra server-side) ---
META_CAPI_TOKEN=

# --- PIXELS / ANALYTICS (opcionales — déjalos vacíos si no los tienes aún) ---
# Meta Pixel ID: Meta Ads Manager → Events Manager → Pixel ID (ej: 1234567890123)
NEXT_PUBLIC_META_PIXEL_ID=
# Microsoft Clarity (mapas de calor): clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=
